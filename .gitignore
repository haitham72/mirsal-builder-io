# Private test photos (people, pets): never commit
inputs/photos/
# Build outputs
generated/

mirsal/.venv/
# Python / offline wheels
__pycache__/
*.pyc
wheels/

# AI cutout models: isnet-general-use is 178MB (over GitHub's 100MB file limit); u2netp (4.6MB) stays in git as the fallback
mirsal/mirsal/models/*.onnx
!mirsal/mirsal/models/u2netp.onnx

# Haitham's input media (478 MB of sheets, 3x3 videos and .mov clips): kept on disk, not in git history.
# The folder layout and naming rules are documented in README.md ("Inputs"). Older checkouts kept them under Phase_01/.
inputs/Images_gen/
inputs/videos_gen/
Phase_01/Images_gen/
Phase_01/videos_gen/
# Old backups pending deletion
_to_delete/

# React gateway (Part G): dependencies and build output
mirsal/web/node_modules/
mirsal/mirsal/console/dist/

# Browser-driver artifacts
.playwright-mcp/
/shot-*.png

# Playwright E2E output
mirsal/web/test-results/
mirsal/web/playwright-report/

# mirsal/out/ is tracked ON PURPOSE (the real generations are the product's data, docs/engine-and-studio.md), but not these: account token digests,
# the signed-link key, the lock files that change on every run, and the console logs
mirsal/out/users.json
mirsal/out/.asset_secret
mirsal/out/.writer.lock
mirsal/out/.paid.lock
mirsal/out/*.log
mirsal/.test-results/

# Secrets: never commit tokens (Telegram bot token lives in env or out/telegram.json)
Phase_01/telegram.md
mirsal/telegram-id.md
**/telegram.json
.tgcred
opencode.json

# keys and tokens: never committed
mirsal/.env
.env
deploy/.env

# macOS and agent worktrees: never committed
.DS_Store
**/.DS_Store
.claude/worktrees/

# one-time safety copies made before a data migration (local only, never in git)
mirsal/out/backups/

# office LAN: session cookies (hashed), account requests (emails), TLS keys and tickets (people's own words) never go to git
mirsal/out/auth_sessions.json
mirsal/out/account_requests.json
mirsal/out/tls/
mirsal/out/tickets/
mirsal/out/trending.json
# what the chat knows about each person (name, place, age, likes): personal, never committed (agent/profile.py)
mirsal/out/profile/

# runtime temp (Haitham, 2026-10-05: commit the media and batch data, never the temp)
mirsal/out/cache/
mirsal/out/reloop-backups/
mirsal/out/support/index.json
