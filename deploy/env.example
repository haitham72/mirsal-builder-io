# Copy to deploy/.env (git-ignored) and fill in. Nothing below is a real value.
POSTGRES_PASSWORD=change-me                                  # compose.yml only
MIRSAL_GATEWAY_SECRET=                                       # 32+ random characters; the SAME value for the web service and the worker (openssl rand -hex 32)
MIRSAL_ALLOWED_HOSTS=mirsal.example.com                      # the host names the gateway answers to
MIRSAL_PUBLIC_ORIGIN=https://mirsal.example.com              # the only Origin that may POST
SUPABASE_URL=https://YOUR-PROJECT.supabase.co                # the JWT issuer is SUPABASE_URL + /auth/v1
SUPABASE_ANON_KEY=                                           # public by design: the browser needs it to start the Google sign-in
# SUPABASE_JWT_SECRET=                                       # only for an old project that still signs with HS256
MIRSAL_DATABASE_URL=                                         # Supabase TRANSACTION pooler URL (port 6543), or postgresql://mirsal:...@db:5432/mirsal with compose
MIRSAL_REDIS_URL=                                            # rediss://default:...@....upstash.io:6379
OPENAI_API_KEY=                                              # the hosted chat has no LM Studio: see plan.md section 11.5 (a budget and a shown price first)
MIRSAL_RATE_PER_MIN=120
MIRSAL_PAID_RATE_PER_MIN=6
MIRSAL_TRACE=none
