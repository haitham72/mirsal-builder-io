# Copy to mirsal/.env (git-ignored) and fill in. Never commit the real file. The real environment wins over this file.

# ========== API KEYS (FILL THESE IN) ==========
OPENAI_API_KEY=                     # official OpenAI key (for Luna 6, gpt-4o-mini, gpt-6.1-sol)
NARAROUTER_API_KEY=                 # Nararouter key (for agnes-2.5-flash, agnes-3-flash, etc.)
MIRSAL_CLOUD_URL=https://router.bynara.id/v1  # Nararouter endpoint (or empty for official OpenAI only)

# ========== DATABASE ==========
MIRSAL_DATABASE_URL=postgresql://mirsal:mirsal_local@localhost:5434/mirsal
MIRSAL_DB_WRITE=1
MIRSAL_REDIS_URL=redis://localhost:6380/0

# ========== LOCAL MODELS ==========
MIRSAL_LOCAL_URL=http://localhost:1234/v1
MIRSAL_LOCAL_MODEL=qwen3.5-4b:2

# ========== CLOUD MODELS ==========
MIRSAL_LLM_PROVIDER=auto            # local | openai | auto (local first when LM Studio answers)
MIRSAL_AGENT_PROVIDER=auto          # the chat assistant
MIRSAL_LLM_MODEL=gpt-6-luna         # cloud chat model (Luna 6)
MIRSAL_LLM_FALLBACK=gpt-6-luna      # fallback for both text and vision calls

# ========== VISION JUDGE ==========
MIRSAL_VISION_PROVIDER=openai       # local | openai | auto
MIRSAL_VISION_OPENAI_MODEL=agnes-2.5-flash  # primary vision model (Nararouter or OpenAI)

# ========== OFFICE NETWORK ==========
MIRSAL_EMAIL_DOMAIN=nadi.ae,cpd.gov.ae

# ========== EXPORT API ==========
MIRSAL_COLLECTION_API_URL=https://emojicms.ehub.ae
MIRSAL_COLLECTION_API_CREDENTIALS=

# ========== OPTIONAL ==========
MIRSAL_API_TOKEN=
MIRSAL_DAILY_CREDITS=
MIRSAL_PREFER_PREPARED=1
MIRSAL_TRACE=none
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
MIRSAL_LANGSMITH_PROJECT=mirsal
MIRSAL_ACTIVITY=1
MIRSAL_ACCESS_LOG=0
