# Copy to mirsal/.env (git-ignored) and fill in. Never commit the real file. The real environment wins over this file.

# Postgres: local mirsal-db on 5434 (docker compose, `python -m mirsal db up`). The default works as is.
MIRSAL_DATABASE_URL=postgresql://mirsal:mirsal_local@localhost:5434/mirsal
# Write every generation, job, ledger line and chat session to Postgres as it happens (`mirsal db import` backfills regardless).
MIRSAL_DB_WRITE=1

# Redis (disposable cache, locks, event streams): mirsal-redis on 6380. NOT REDIS_URL: that name is shared with other projects and is ignored.
MIRSAL_REDIS_URL=redis://localhost:6380/0

# Language models. Nothing asks LM Studio which models it has: the local model is hardcoded (qwen3.5-4b:2; embeddings nomic-embed-text-v1.5).
MIRSAL_LOCAL_URL=http://localhost:1234/v1
MIRSAL_LOCAL_MODEL=qwen3.5-4b:2
MIRSAL_LLM_PROVIDER=auto            # local | openai | auto (local first when LM Studio answers)
MIRSAL_AGENT_PROVIDER=auto          # the chat assistant;  MIRSAL_VISION_PROVIDER=auto  the vision judge
OPENAI_API_KEY=                     # optional fallback when LM Studio is not running
# Auto mode only, when cloud is usable: local attempt budget; fallback gets the remaining total timeout.
# MIRSAL_AUTO_LOCAL_TIMEOUT=15

# Tracing: none | langsmith. The project is MIRSAL_LANGSMITH_PROJECT (default mirsal); LANGSMITH_PROJECT is ignored on purpose.
MIRSAL_TRACE=none
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# MIRSAL_LANGSMITH_PROJECT=mirsal

# API token (optional): when set, callers other than the Studio's own page must send  Authorization: Bearer <token>.
# MIRSAL_API_TOKEN=

# Spending guard for live generation (credits per day; unset = no cap).
# MIRSAL_DAILY_CREDITS=

# Prepared sheets first: a request that names a prepared subject is served from the watch folder (0 credits)
# instead of a paid Higgsfield call. 1 (default) = on, 0 = off. The owner's Settings switch does the same;
# this line wins when it is set. Restart after a change.
# MIRSAL_PREFER_PREPARED=1

# Office network (serve --lan): the email domains that may sign up, comma-separated. Empty = any domain. Restart after a change.
# MIRSAL_EMAIL_DOMAIN=nadi.ae,cpd.gov.ae

# Export to collection (Library pack page and Studio batch: "Export to collection"): the external AddCollection API (docs/Api/).
# CREDENTIALS is base64 of user:password, or user:password itself (it is encoded for you). Never commit the real value. Restart after a change.
# MIRSAL_COLLECTION_API_URL=https://emojicms.ehub.ae
# MIRSAL_COLLECTION_API_CREDENTIALS=

# The terminal: one short line per event (generating, received, cut, exported, ERROR ...). 0 = quiet. Default on.
# MIRSAL_ACTIVITY=1
# One JSON line per HTTP request (very verbose: the Studio polls every second). Debugging only.
# MIRSAL_ACCESS_LOG=0
