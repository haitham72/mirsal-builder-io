# Copy to mirsal/.env (git-ignored) and fill in. Never commit the real file.
# Postgres (Phase 3A): local mirsal-db on 5434. The dev default works with docker-compose.yml as is.
MIRSAL_DATABASE_URL=postgresql://mirsal:mirsal_local@localhost:5434/mirsal
# Write every generation to Postgres as it runs (doctor reports on/off). `mirsal db import` backfills regardless.
MIRSAL_DB_WRITE=1
# AI expansion (Phase 1/2): OpenAI Chat Completions.
OPENAI_API_KEY=
# Tracing (Phase 3A, second half): none | langsmith.
MIRSAL_TRACE=none
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=mirsal
